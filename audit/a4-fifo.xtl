#!/usr/bin/env xetal
# A4: a bounded FIFO as an array: offer at the back (c_at), take from
# the front (f_irst, 1 d_rop), and several connections' contents as
# rows of a matrix padded to the largest capacity, replaced with a_mend.
q := 0 r_eshape 0
q2 := q c_at 7 8 9
f_irst q2
1 d_rop q2
Q := 3 4 r_eshape 0
Q a_mend (2, 4 t_ake 5 6)
counts := 0 2 0
counts a_mend (2, 1 + 2 s_elect counts)
# a ring buffer: two items written after a head of 3 in a vector of 4
# go to positions 4 and 1, wrapping round (indices by m_od)
cap := 4
at := 1 + (3 + o_ffsets 2) m_od cap
at
(cap r_eshape 0) a_mend (at, 11 12)
