#!/usr/bin/env bash
# The known-good xetal (bin/xetal, scripts/xetal.sh) with every library
# on the search path: this repository's libs/<Name>/src first, then the
# known-good X_eTaL-libraries' (work/libraries, scripts/libraries.sh),
# each written relative to the current directory so messages and
# baselines do not depend on where the repository is checked out.
# "xt run FILE" adds --seed 1 --ascii and --draw work/draw (as the
# tests run); any other command passes through.
#   scripts/xt run prog.xtl
#   scripts/xt type ../src/Connections.xtl
#   scripts/xt eval -e "'+ r_/ 1 2 3"
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
xetal="${XETAL_BIN:-$root/bin/xetal}"
[ -x "$xetal" ] || "$root/scripts/xetal.sh" >&2
[ -d "$root/work/libraries/libs" ] || "$root/scripts/libraries.sh" >/dev/null
mkdir -p "$root/work/draw"
eval "$(uv run --no-project python3 - "$root" <<'PY'
import os, sys
from pathlib import Path
root = Path(sys.argv[1])
dirs = sorted(d for d in root.glob("libs/*/src") if d.is_dir())
dirs += sorted(d for d in root.glob("work/libraries/libs/*/src") if d.is_dir())
print("export XETAL_PATH=" + repr(":".join(os.path.relpath(d) for d in dirs)))
print("draw=" + repr(os.path.relpath(root / "work" / "draw")))
PY
)"
if [ "${1:-}" = run ]; then shift; exec "$xetal" run --seed 1 --ascii --draw "$draw" "$@"; fi
exec "$xetal" "$@"
